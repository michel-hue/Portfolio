# Copie ce fichier en .env.local et remplis les valeurs. Ne commite jamais .env.local.

DATABASE_URL=            # chaîne de connexion Neon (pooled)
SESSION_SECRET=          # 32+ caractères aléatoires
ADMIN_PASSWORD_HASH=     # hash bcrypt du mot de passe admin, en base64 (npm run hash-password)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IP_HASH_SECRET=          # pour hasher les IP du formulaire de contact
NEXT_PUBLIC_SITE_URL=    # https://… (sitemap, OG)
